# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
VAPI_SECRET_TOKEN=your_vapi_custom_credential_bearer_token

# Integration #1: Airtable (Inbound Customer & Claims Read)
AIRTABLE_API_KEY=pat_your_airtable_personal_access_token
AIRTABLE_BASE_ID=app_your_airtable_base_id
AIRTABLE_TABLE_NAME=Claims

# Integration #2: Airtable (Post-Call Interaction Logging Write)
AIRTABLE_LOGS_TABLE_NAME=CallLogs

# Redundant / Backup Integration #2: Google Sheets (Optional)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=credentials/google_service_account.json
GOOGLE_SHEET_NAME=Observe_Insurance_Call_Logs
GOOGLE_SHEET_TAB_NAME=CallLogs
